{
  "title": "圍魏救趙",
  "narrator_sha256": "896e60ee1f244cef63c3e25fd8c552c8de922b9d687e5810ad44bd5d5c928477",
  "roles": {
    "旁白": "068",
    "田忌": "ZH_Yunjian",
    "孫臏": "ZH_Yunxi"
  },
  "segments": [
    {
      "text": "圍魏救趙：孫臏的聰明辦法。",
      "role": "旁白",
      "scene": 1,
      "source_range": [
        0,
        2.844
      ]
    },
    {
      "text": "魏國的大軍包圍了趙國的都城邯鄲。",
      "role": "旁白",
      "scene": 1,
      "source_range": [
        2.844,
        5.812
      ]
    },
    {
      "text": "趙國趕緊派人向齊國求救。",
      "role": "旁白",
      "scene": 1,
      "source_range": [
        5.812,
        8.427
      ]
    },
    {
      "text": "我們快去邯鄲，幫趙國解圍！",
      "role": "田忌",
      "scene": 2
    },
    {
      "text": "先等等。",
      "role": "孫臏",
      "scene": 3
    },
    {
      "text": "魏國的主力都在趙國，它自己的都城，守軍就少了。",
      "role": "孫臏",
      "scene": 3
    },
    {
      "text": "要救趙國，為什麼看著魏國？",
      "role": "田忌",
      "scene": 3
    },
    {
      "text": "如果我們進逼魏國的都城大梁，魏軍就得趕回去保護自己的家。",
      "role": "孫臏",
      "scene": 4
    },
    {
      "text": "田忌採納了這個辦法，率領齊軍向大梁進發。",
      "role": "旁白",
      "scene": 4,
      "source_range": [
        30.719,
        34.635
      ]
    },
    {
      "text": "魏軍得知都城受到威脅，果然撤離邯鄲，急忙回援。",
      "role": "旁白",
      "scene": 5,
      "source_range": [
        34.635,
        39.24
      ]
    },
    {
      "text": "齊軍在桂陵迎擊魏軍，取得勝利，趙國的危機也因此解除。",
      "role": "旁白",
      "scene": 5,
      "source_range": [
        39.24,
        44.385
      ]
    },
    {
      "text": "這就是圍魏救趙。",
      "role": "旁白",
      "scene": 6,
      "source_range": [
        44.385,
        46.292
      ]
    },
    {
      "text": "遇到難題時，先看清楚整個局面。",
      "role": "旁白",
      "scene": 6,
      "source_range": [
        46.292,
        49.531
      ]
    },
    {
      "text": "有時候，換一條路，就能找到解決問題的辦法。",
      "role": "旁白",
      "scene": 6,
      "source_range": [
        49.531,
        53.733878
      ]
    }
  ]
}
