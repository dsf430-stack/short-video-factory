  "subtitle_cues": [
    {
      "start": 0.05,
      "end": 4.208,
      "text": "凌晨三點十七分，便利商店來了一位奇怪的客人。"
    },
    {
      "start": 6.05,
      "end": 7.615,
      "text": "自動門開了。"
    },
    {
      "start": 7.615,
      "end": 10.26,
      "text": "她站在門口，沒有腳步聲。"
    },
    {
      "start": 13.05,
      "end": 15.677,
      "text": "她問店員，你看得到我嗎？"
    },
    {
      "start": 22.05,
      "end": 25.01,
      "text": "店員回答，妳不是就在我面前？"
    },
    {
      "start": 31.05,
      "end": 34.448,
      "text": "女子沒有回答，只指向頭頂的監視器。"
    },
    {
      "start": 40.05,
      "end": 43.115,
      "text": "螢幕裡，櫃台前竟然沒有任何人。"
    },
    {
      "start": 51.05,
      "end": 54.792,
      "text": "就在這時，螢幕跳出四個字，不要回頭。"
    }
  ],
