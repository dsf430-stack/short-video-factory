[
  {
    "index": 0,
    "text": "一般木製黑鉛筆裡面,其實沒有金屬鉛",
    "start": 0.0,
    "end": 3.64
  },
  {
    "index": 1,
    "text": "每天寫字的你,有沒有被這個名字騙過?",
    "start": 3.64,
    "end": 7.0
  },
  {
    "index": 2,
    "text": "筆芯主要是石墨和黏土",
    "start": 7.0,
    "end": 9.48
  },
  {
    "index": 3,
    "text": "石墨留下黑色痕跡,黏土調整筆芯硬度",
    "start": 9.48,
    "end": 13.2
  },
  {
    "index": 4,
    "text": "黏土比例越高,筆芯通常越硬",
    "start": 13.2,
    "end": 15.68
  },
  {
    "index": 5,
    "text": "石墨比例越高,通常越軟,越黑",
    "start": 15.68,
    "end": 18.96
  },
  {
    "index": 6,
    "text": "下次拿起鉛筆,想起來了吧?",
    "start": 18.96,
    "end": 21.88
  },
  {
    "index": 7,
    "text": "名字雖然叫鉛筆,真正陪你寫字、畫圖",
    "start": 21.88,
    "end": 25.32
  },
  {
    "index": 8,
    "text": "留下每一筆痕跡的,其實是石墨",
    "start": 25.32,
    "end": 28.2
  }
]
